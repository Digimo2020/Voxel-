# Text 2 Voice — Environment Variables Example
# Copy this file to .env to override default application settings.

# Default Neural Voice (en-US-JennyNeural, en-US-GuyNeural, en-GB-SoniaNeural)
T2V_DEFAULT_VOICE="en-US-JennyNeural"

# Default Playback Speed (0.5 to 2.0)
T2V_DEFAULT_SPEED="1.0"

# Floating Speaker Trigger Timeout in seconds (default: 4.0)
T2V_BUBBLE_TIMEOUT="4.0"

# Global Shortcut (Windows: <ctrl>+<alt>+s, macOS: <cmd>+<alt>+s)
T2V_HOTKEY="<ctrl>+<alt>+s"

# Enable Debug Logging (true / false)
T2V_DEBUG="false"
