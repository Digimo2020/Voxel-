<?xml version="1.0" encoding="utf-8"?>
<!-- Paste this into SignPath: Project -> Artifact configurations -> Add (slug: initial).
     The GitHub Action uploads a zip containing dist/Voxel-v*.exe; this signs the exe inside it. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Voxel-v*.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
